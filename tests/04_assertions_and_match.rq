assert(1 == 1);
assert_true(true);
assert_false(false);
assert_null(null);
assert_eq(10 + 5, 15);
assert_ne(10, 20);

var matchedNum = "";
match (2) {
    1 => matchedNum = "one",
    2 => matchedNum = "two",
    _ => matchedNum = "other"
}
assert_eq(matchedNum, "two");

var matchedStr = "";
match "world" {
    "hello" => { matchedStr = "h"; }
    "world" => { matchedStr = "w"; }
    _ => { matchedStr = "unknown"; }
}
assert_eq(matchedStr, "w");

var matchedDefault = "";
match 999 {
    1 => matchedDefault = "one",
    _ => matchedDefault = "fallback"
}
assert_eq(matchedDefault, "fallback");

var name = "RayQuiro";
var ver = 2;
var interpolated = f"Language: {name} v0.{ver}";
assert_eq(interpolated, "Language: RayQuiro v0.2");

var backtickStr = `Hello ${name}!`;
assert_eq(backtickStr, "Hello RayQuiro!");

print("04_assertions_and_match: PASS");
